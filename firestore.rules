rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to get the current user's companyId
    function getUserCompanyId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId;
    }

    // Superadmins are identified by their @weareenzyme.com email, same check
    // used client-side in src/app/(app)/superadmin/page.tsx.
    function isSuperadmin() {
      return request.auth != null &&
        request.auth.token.email != null &&
        request.auth.token.email.matches('.*@weareenzyme[.]com$');
    }

    // Admins can manage sensitive company configuration (salaries, overheads).
    function isAdmin() {
      return request.auth != null &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' || isSuperadmin());
    }

    // True if the caller is an admin of the given company (used for the
    // Settings > Team tab, where an admin edits/removes a teammate's own
    // users/{uid} doc).
    function isAdminOfCompany(companyId) {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == companyId;
    }

    // Collections holding raw salary/overhead figures: only admins may create,
    // update or delete these documents. Reads remain company-scoped below
    // (any team member can still read them today; restricting reads too would
    // require splitting these into public/private documents).
    function isSensitiveCollection(path) {
      return path.split('/')[0] == 'teamMembers' || path.split('/')[0] == 'overheadsProfile';
    }

    // Company finances (bank balance, debts, commissions): admins only, for reads too.
    // Written and read only by the server (AI access keys).
    function isServerOnlyCollection(path) {
      return path.split('/')[0] in ['mcpTokens', 'mcpChanges', 'oauthClients', 'oauthCodes', 'oauthGrants', 'aiSettings'];
    }

    function isAdminOnlyCollection(path) {
      return path.split('/')[0] == 'forecastProfile';
    }

    // Companies collection
    match /companies/{companyId} {
      allow read: if request.auth != null && (getUserCompanyId() == companyId || isSuperadmin());
      // Creation during signup: only the document matching the new company, no companyId yet to compare against.
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (getUserCompanyId() == companyId || isSuperadmin());
    }

    // Users collection. companyId/role are assigned server-side on creation
    // (see src/app/api/auth/provision/route.ts, which uses the Admin SDK and
    // so bypasses these rules) after validating signup/invite acceptance.
    // Clients can never create a user doc, and can only update an existing
    // one without changing its companyId, which previously allowed
    // self-escalation into any company as 'admin'.
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isSuperadmin());

      // A user may edit their own doc (e.g. displayName) but never their own role or companyId.
      allow update: if request.auth != null && request.auth.uid == userId &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.companyId == resource.data.companyId;

      // An admin may edit a teammate's role/displayName within their own company,
      // but may not move them to a different company.
      allow update: if isAdminOfCompany(resource.data.companyId) &&
        request.resource.data.companyId == resource.data.companyId;

      // Self-removal (account deletion) or an admin removing a teammate from their own company.
      allow delete: if request.auth != null &&
        (request.auth.uid == userId || isAdminOfCompany(resource.data.companyId));

      allow create: if isSuperadmin();
    }

    // All other collections (strictly enforced by companyId)
    match /{document=**} {
      allow create: if request.auth != null && !isServerOnlyCollection(document) &&
        (request.resource.data.companyId == getUserCompanyId() || isSuperadmin()) &&
        (!isSensitiveCollection(document) || isAdmin()) &&
        (!isAdminOnlyCollection(document) || isAdmin());

      allow read: if request.auth != null && !isServerOnlyCollection(document) &&
        (resource.data.companyId == getUserCompanyId() || isSuperadmin()) &&
        (!isAdminOnlyCollection(document) || isAdmin());

      allow update, delete: if request.auth != null && !isServerOnlyCollection(document) &&
        (resource.data.companyId == getUserCompanyId() || isSuperadmin()) &&
        (!isSensitiveCollection(document) || isAdmin()) &&
        (!isAdminOnlyCollection(document) || isAdmin());
    }
  }
}
